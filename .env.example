PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
RESEND_API_KEY=<your-resend-api-key>

# CRM only — Supabase dashboard > Settings > API > service_role key.
# Server-only, never exposed to the browser. Used solely to create a
# client's Supabase Auth login when you add them in /crm/admin/clients/new.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# CRM invoice generator — printed on every invoice as the "Payable to" /
# payment block. Keep these out of source control; server-only.
INVOICE_PAYEE_NAME=<your-name>
INVOICE_PAYEE_ADDRESS=<your-billing-address>
INVOICE_BANK_NAME=<your-bank-name>
INVOICE_ACCOUNT_NAME=<account-holder-name>
INVOICE_ACCOUNT_NUMBER=<account-number>
INVOICE_IFSC_CODE=<ifsc-code>
INVOICE_UPI_ID=<upi-id>
INVOICE_CONTACT_PHONE=<contact-phone>
INVOICE_CONTACT_WEBSITE=<contact-website>
